# Required for official MyAnimeList v2 catalogue requests.
MAL_CLIENT_ID=replace-with-your-myanimelist-client-id

# AnimePahe may require browser challenge cookies before its API will serve streams.
# Copy the current cookies from a browser session that can open animepahe.pw.
# Include cf_clearance when Cloudflare supplies it, along with any __ddg* cookies.
# ANIMEPAHE_COOKIES={"cf_clearance":"value","__ddg1_":"value"}
# Or set ANIMEPAHE_CF_CLEARANCE and ANIMEPAHE_DDG1 separately.

# Optional local server settings.
HOST=127.0.0.1
PORT=4444
DEBUG=false
